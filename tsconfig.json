{
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"],
			"@/styles/*": ["./src/styles/*"],
			"@/lib/*": ["./src/lib/*"],
			"@/auth/*": ["./src/ui/auth/*"]
		},
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"incremental": true,
		"module": "esnext",
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts",
		"**/*.ts",
		"**/*.tsx"
	],
	"exclude": ["node_modules"]
}
